providers:
  # 原 openai（scitrace 中转 GPT 系）；官方 OpenAI 将来直用内置 openai provider
  sci-openai:
    baseUrl: https://sub.scitrace.cc
    apiKey: @SCI_OPENAI_KEY@
    api: openai-responses
    models:
      - id: gpt-5.5
        name: sci-openai · GPT-5.5
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
      - id: gpt-5.6
        name: sci-openai · GPT-5.6
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
      - id: gpt-5.6-sol
        name: sci-openai · GPT-5.6 Sol
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
      - id: gpt-5.6-terra
        name: sci-openai · GPT-5.6 Terra
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
      - id: gpt-6
        name: sci-openai · GPT-6
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
      - id: gpt-6-astra
